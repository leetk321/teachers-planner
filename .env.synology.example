# Every deployment must use a unique, immutable application image tag.
TEACHER_NOTEBOOK_VERSION=3.16.0
TEACHER_API_IMAGE=teacher-notebook-api
TEACHER_WEB_IMAGE=teacher-notebook-web

# Match these ports to your reverse proxy; replace the example domains before building.
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=https://api.note.example.com
CORS_ORIGINS=https://note.example.com

# Keep secrets only in the NAS project environment. Never commit real values.
KMA_AUTH_KEY=
TEACHER_NOTEBOOK_ADMIN_BOOTSTRAP_TOKEN=

# Example persistent NAS data path. Set your actual data path, never the source directory.
DATA_HOST_PATH=/volume1/docker/teacher-notebook-data
DATA_VOLUME_REQUIRE_MARKER=true

# Online SQLite backup retention. Both limits are applied.
BACKUP_RETAIN_COUNT=30
BACKUP_RETENTION_DAYS=90
